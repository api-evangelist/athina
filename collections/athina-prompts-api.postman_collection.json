          "name": "Create or version a prompt template",
          "request": {
            "name": "Create or version a prompt template",
            "description": {
              "content": "Create a prompt template at the given slug, or create a new incremented version if the slug already exists. Supports template variables of the form {{variable_name}} within message content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "prompt",
                ":prompt_slug"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "prompt_slug",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"model\": \"<string>\",\n  \"parameters\": {\n    \"temperature\": \"<number>\",\n    \"max_tokens\": \"<integer>\",\n    \"top_p\": \"<number>\",\n    \"presence_penalty\": \"<number>\",\n    \"frequency_penalty\": \"<number>\"\n  },\n  \"commit_message\": \"<string>\"\n}",
