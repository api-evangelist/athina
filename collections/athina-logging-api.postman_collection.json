        {
          "id": "7530cca7-4448-430c-b62a-c2f34a716a31",
          "name": "Log an LLM inference",
          "request": {
            "name": "Log an LLM inference",
            "description": {
              "content": "Logs a single LLM inference (prompt run) to Athina for monitoring and evaluation. The prompt may be a plain string or an OpenAI-style messages array. Optional fields capture token usage, cost, latency, retrieved context, and customer/session metadata for segmentation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "log",
                "inference"
              ],
              "host": [
                "{{log-inference-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language_model_id\": \"<string>\",\n  \"prompt\": \"<string>\",\n  \"response\": \"<string>\",\n  \"user_query\": \"<string>\",\n  \"context\": \"<string>\",\n  \"expected_response\": \"<string>\",\n  \"session_id\": \"<string>\",\n  \"prompt_tokens\": \"<number>\",\n  \"completion_tokens\": \"<number>\",\n  \"total_tokens\": \"<number>\",\n  \"cost\": \"<number>\",\n  \"response_time\": \"<number>\",\n  \"environment\": \"<string>\",\n  \"prompt_slug\": \"<string>\",\n  \"customer_id\": \"<string>\",\n  \"customer_user_id\": \"<string>\",\n  \"external_reference_id\": \"<string>\",\n  \"functions\": \"<object>\",\n  \"function_call_response\": \"<string>\",\n  \"tools\": \"<object>\",\n  \"tool_calls\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "5ca0715f-cac9-4b03-bf1b-729a8bf4614d",
              "name": "Inference logged successfully.",
              "originalRequest": {
